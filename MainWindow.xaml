<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreetFighter_Game"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif" x:Class="StreetFighter_Game.MainWindow"       
        mc:Ignorable="d"
        Title="Dmitry Muntyan Lesson_1" Height="450" Width="800" Margin="0">
    <Grid UseLayoutRounding="True" RenderTransformOrigin="0.5,0.5" Margin="0">
        <Grid.Effect>
            <DropShadowEffect/>
        </Grid.Effect>
        <Grid.Background>
            <ImageBrush ImageSource="fighting background.JPG"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="182*"/>
            <ColumnDefinition Width="367*"/>
            <ColumnDefinition Width="243*"/>
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Image x:Name="Image2" gif:AnimationBehavior.SourceUri="Resources/Ryu.gif" HorizontalAlignment="Left" Height="202" Margin="60,190,0,0" VerticalAlignment="Top" Width="177" RenderTransformOrigin="0.5,0.5" Grid.Column="2">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="1" ScaleX="-1"/>
                    <SkewTransform AngleY="0" AngleX="0"/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="Image3" gif:AnimationBehavior.SourceUri="Resources/Ken.gif" HorizontalAlignment="Left" Height="198" Margin="24,194,0,0" VerticalAlignment="Top" Width="181" Grid.ColumnSpan="2"/>
        <TextBox x:Name="text_Name" HorizontalAlignment="Left" Height="23" Margin="109,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="70" BorderThickness="3" Grid.Column="1">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Button x:Name="Button_Attack" Content="Attack" HorizontalAlignment="Left" Margin="109,254,0,0" VerticalAlignment="Top" Width="75" Click="Button_Attack_Click" Grid.Column="1">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="Button_Create" Content="Create" HorizontalAlignment="Left" Margin="205,13,0,0" VerticalAlignment="Top" Width="75" Click="Button_Create_Click" Grid.Column="1">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <ListBox x:Name="List" HorizontalAlignment="Left" Height="56" Margin="10,10,0,0" VerticalAlignment="Top" Width="267" SelectionChanged="ListBox_SelectionChanged" Background="White" Grid.ColumnSpan="2">
            <ListBox.Effect>
                <DropShadowEffect/>
            </ListBox.Effect>
        </ListBox>
        <Label x:Name="label_PlayerDamage" Content="DMG" HorizontalAlignment="Left" Margin="24,91,0,0" VerticalAlignment="Top" Width="148" Height="43" FontSize="24"/>
        <Label x:Name="label_EnemyDamage" Content="DMG" HorizontalAlignment="Left" Margin="29,91,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.479,-1.243" Grid.Column="2" Width="140" Height="43" FontSize="24"/>
        <StatusBar Name="SBar" Grid.Column="0" VerticalAlignment="Bottom" Background="LightBlue" Grid.ColumnSpan="3"/>
        <Button x:Name="Button_block" Content="Block" Grid.Column="1" HorizontalAlignment="Left" Margin="205,254,0,0" VerticalAlignment="Top" Width="75" Click="Button_block_Click">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="Button_Attack_Head" Content="Head" Grid.Column="1" HorizontalAlignment="Left" Margin="109,169,0,0" VerticalAlignment="Top" Width="75" Click="Button_Attack_Head_Click">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="Button_Attack_Torso" Content="Torso" Grid.Column="1" HorizontalAlignment="Left" Margin="109,194,0,0" VerticalAlignment="Top" Width="75">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="Button_Attack_Leg" Content="Leg" Grid.Column="1" HorizontalAlignment="Left" Margin="109,219,0,0" VerticalAlignment="Top" Width="75">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Label Content="Attack" Grid.Column="1" HorizontalAlignment="Left" Margin="118,135,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Button x:Name="Button_Block_head" Content="Head" Grid.Column="1" HorizontalAlignment="Left" Margin="205,169,0,0" VerticalAlignment="Top" Width="75">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="Button_Block_Torso" Content="Torso" Grid.Column="1" HorizontalAlignment="Left" Margin="205,194,0,0" VerticalAlignment="Top" Width="75">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Button x:Name="Button_Block_Leg" Content="Leg" Grid.Column="1" HorizontalAlignment="Left" Margin="205,219,0,0" VerticalAlignment="Top" Width="75">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Label Content="Block" Grid.Column="1" HorizontalAlignment="Left" Margin="217,137,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Canvas>
            <Grid>
                <ProgressBar x:Name="pbhealth_enemy" HorizontalAlignment="Left" Height="17" VerticalAlignment="Top" Width="350" Canvas.Left="10" Canvas.Top="74" Value="100" Foreground="#FFFB440E" ValueChanged="pbhealth_ValueChanged" Padding="0" BorderThickness="0" Margin="427,74,-427,-74">
                    <ProgressBar.Effect>
                        <DropShadowEffect/>
                    </ProgressBar.Effect>
                </ProgressBar>
                <ProgressBar x:Name="pbhealth_person" HorizontalAlignment="Left" Height="17" VerticalAlignment="Top" Width="350" Canvas.Left="430" Canvas.Top="74" Value="100" Foreground="#FFFB440E" ValueChanged="pbhealth_ValueChanged" BorderThickness="0" BorderBrush="#FFF7F1F1" Padding="0,0,0,0" Background="WhiteSmoke" Margin="10,74,-10,-74">
                    <ProgressBar.Effect>
                        <DropShadowEffect/>
                    </ProgressBar.Effect>
                </ProgressBar>
                <TextBlock Name ="TxtPersonHealthBar"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Text=" Person HP" Margin="10,74,283,-74"/>
                <TextBlock x:Name="TxtEnemyHealthBar"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Text=" Enemy HP" Margin="426,74,-134,-74"/>
            </Grid>

        </Canvas>
        <ListBox x:Name="EnemyList" Grid.Column="1" Margin="316,10,23,348" SelectionChanged="EnemyList_SelectionChanged" Grid.ColumnSpan="2">
            <ListBox.Effect>
                <DropShadowEffect/>
            </ListBox.Effect>
        </ListBox>
        <CheckBox x:Name="CheckBox_Attack_Head" Content="" Grid.Column="1" HorizontalAlignment="Left" Margin="74,169,0,0" VerticalAlignment="Top" ClickMode="Press" RenderTransformOrigin="3.4,0.6" Checked="CheckBox_Attack_Head_Checked" Height="18" Width="21">
            <CheckBox.Effect>
                <DropShadowEffect/>
            </CheckBox.Effect>
        </CheckBox>
        <CheckBox x:Name="CheckBox_Attack_Torso" Content="" Grid.Column="1" HorizontalAlignment="Left" Margin="74,194,0,0" VerticalAlignment="Top" ClickMode="Press" Checked="CheckBox_Attack_Torso_Checked">
            <CheckBox.Effect>
                <DropShadowEffect/>
            </CheckBox.Effect>
        </CheckBox>
        <CheckBox x:Name="CheckBox_Attack_Leg" Content="" Grid.Column="1" HorizontalAlignment="Left" Margin="74,219,0,0" VerticalAlignment="Top" RenderTransformOrigin="3.3,0.6" ClickMode="Press" Checked="CheckBox_Attack_Leg_Checked">
            <CheckBox.Effect>
                <DropShadowEffect/>
            </CheckBox.Effect>
        </CheckBox>
        <CheckBox x:Name="CheckBox_Block_Head" Content="" Grid.Column="1" HorizontalAlignment="Left" Margin="301,172,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.258,0.467" Checked="CheckBox_Block_Head_Checked">
            <CheckBox.Effect>
                <DropShadowEffect/>
            </CheckBox.Effect>
        </CheckBox>
        <CheckBox x:Name="CheckBox_Block_Torso" Content="" Grid.Column="1" HorizontalAlignment="Left" Margin="301,194,0,0" VerticalAlignment="Top" Checked="CheckBox_Block_Torso_Checked">
            <CheckBox.Effect>
                <DropShadowEffect/>
            </CheckBox.Effect>
        </CheckBox>
        <CheckBox x:Name="CheckBox_Block_Leg" Content="" Grid.Column="1" HorizontalAlignment="Left" Margin="301,219,0,0" VerticalAlignment="Top" Checked="CheckBox_Block_Leg_Checked">
            <CheckBox.Effect>
                <DropShadowEffect/>
            </CheckBox.Effect>
        </CheckBox>


    </Grid>
</Window>
